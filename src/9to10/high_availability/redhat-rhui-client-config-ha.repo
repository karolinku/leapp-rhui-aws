[rhui-client-config-server-10-ha]
name=RHUI Client Configuration Server 10 HA
mirrorlist=https://rhui.REGION.aws.ce.redhat.com/pulp/mirror/protected/rhui-client-config/rhel/server/10/$basearch/ha
enabled=1
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-redhat-release
sslverify=1
sslcacert=/etc/pki/rhui/cdn.redhat.com-chain.crt
sslclientcert=/etc/pki/rhui/product/rhui-client-config-server-10-ha.crt
sslclientkey=/etc/pki/rhui/rhui-client-config-server-10-ha.key

