[rhui-client-config-server-8-sap-bundle]
name=RHUI Client Configuration for SAP Bundle
mirrorlist=https://rhui.REGION.aws.ce.redhat.com/pulp/mirror/protected/rhui-client-config/rhel/server/8/$basearch/sap-bundle
enabled=0
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-redhat-release
sslverify=1
sslcacert=/etc/pki/rhui/cdn.redhat.com-chain.crt
sslclientcert=/etc/pki/rhui/product/rhui-client-config-server-8-sap-bundle.crt
sslclientkey=/etc/pki/rhui/rhui-client-config-server-8-sap-bundle.key

